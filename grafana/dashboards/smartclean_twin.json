{
  "title": "SmartClean Twin - Robot Dashboard",
  "uid": "smartclean-main",
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Battery State of Charge (%)",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "orange", "value": 20},
              {"color": "green", "value": 50}
            ]
          }
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_telemetry\" and r._field == \"battery_soc\") |> last()"
      }]
    },
    {
      "id": 2,
      "title": "Motor Current (A)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 9, "x": 6, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "orange", "value": 1.5},
              {"color": "red", "value": 2.5}
            ]
          }
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"robot_telemetry\" and r._field == \"motor_current_a\")"
      }]
    },
    {
      "id": 3,
      "title": "Cleaning Coverage (%)",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 9, "x": 15, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "steps": [
              {"color": "blue", "value": 0},
              {"color": "green", "value": 90}
            ]
          }
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_state\" and r._field == \"cleaning_coverage_pct\") |> last()"
      }]
    },
    {
      "id": 4,
      "title": "Robot Position X (m)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 6},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"robot_telemetry\" and (r._field == \"x_m\" or r._field == \"y_m\"))"
      }]
    },
    {
      "id": 5,
      "title": "Obstacle Distance (cm)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 6},
      "fieldConfig": {
        "defaults": {
          "unit": "lengthcm",
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "orange", "value": 25},
              {"color": "green", "value": 50}
            ]
          }
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"robot_telemetry\" and r._field == \"obstacle_cm\")"
      }]
    },
    {
      "id": 6,
      "title": "Motor Temperature (C)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 12},
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "orange", "value": 55},
              {"color": "red", "value": 70}
            ]
          }
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"robot_telemetry\" and r._field == \"motor_temperature_c\")"
      }]
    },
    {
      "id": 7,
      "title": "Safety State",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 12},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/_value/", "values": false},
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"SAFE":        {"text": "SAFE",        "color": "green",  "index": 0}}},
            {"type": "value", "options": {"WARNING":     {"text": "WARNING",     "color": "orange", "index": 1}}},
            {"type": "value", "options": {"EMERGENCY":   {"text": "EMERGENCY",   "color": "red",    "index": 2}}},
            {"type": "value", "options": {"UNKNOWN":     {"text": "UNKNOWN",     "color": "gray",   "index": 3}}}
          ]
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_state\" and r._field == \"safety_state\") |> last()"
      }]
    },
    {
      "id": 8,
      "title": "Mission State",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 12},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/_value/", "values": false},
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"NOT_STARTED": {"text": "NOT STARTED", "color": "gray",   "index": 0}}},
            {"type": "value", "options": {"RUNNING":     {"text": "RUNNING",     "color": "green",  "index": 1}}},
            {"type": "value", "options": {"PAUSED":      {"text": "PAUSED",      "color": "orange", "index": 2}}},
            {"type": "value", "options": {"COMPLETED":   {"text": "COMPLETED",   "color": "blue",   "index": 3}}},
            {"type": "value", "options": {"ABORTED":     {"text": "ABORTED",     "color": "red",    "index": 4}}}
          ]
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_state\" and r._field == \"mission_state\") |> last()"
      }]
    },
    {
      "id": 9,
      "title": "AI Motor Health Prediction",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 18},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/_value/", "values": false},
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"NORMAL":     {"text": "NORMAL",     "color": "green",  "index": 0}}},
            {"type": "value", "options": {"HIGH_LOAD":  {"text": "HIGH LOAD",  "color": "orange", "index": 1}}},
            {"type": "value", "options": {"OVERHEATED": {"text": "OVERHEATED", "color": "red",    "index": 2}}},
            {"type": "value", "options": {"FAULT":      {"text": "FAULT",      "color": "dark-red","index": 3}}}
          ]
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_prediction\" and r._field == \"motor_health\") |> last()"
      }]
    },
    {
      "id": 10,
      "title": "AI Dirt Level Prediction",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 18},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/_value/", "values": false},
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"CLEAN":    {"text": "CLEAN",    "color": "green",  "index": 0}}},
            {"type": "value", "options": {"MODERATE": {"text": "MODERATE", "color": "orange", "index": 1}}},
            {"type": "value", "options": {"DIRTY":    {"text": "DIRTY",    "color": "red",    "index": 2}}}
          ]
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_prediction\" and r._field == \"dirt_level\") |> last()"
      }]
    },
    {
      "id": 11,
      "title": "Active Alarm Count",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 18},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/_value/", "values": false},
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "red", "value": 1}
            ]
          }
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_state\" and r._field == \"alarm_count\") |> last()"
      }]
    },
    {
      "id": 12,
      "title": "Battery Voltage (V)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 22},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"robot_telemetry\" and r._field == \"battery_v\")"
      }]
    },
    {
      "id": 13,
      "title": "Dirt Score",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 22},
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "orange", "value": 0.3},
              {"color": "red", "value": 0.7}
            ]
          }
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"robot_telemetry\" and r._field == \"dirt_score\")"
      }]
    },
    {
      "id": 14,
      "title": "Alarm History",
      "type": "table",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 28},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -1h) |> filter(fn: (r) => r._measurement == \"robot_alarm\") |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> sort(columns: [\"_time\"], desc: true) |> limit(n: 50)"
      }]
    }
  ],
  "schemaVersion": 36,
  "tags": ["smartclean", "digital-twin", "robot"]
}
