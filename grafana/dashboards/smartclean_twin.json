{
  "title": "SmartClean Twin - Robot Dashboard",
  "uid": "smartclean-main",
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Battery State of Charge (%)",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "orange", "value": 20},
              {"color": "green", "value": 50}
            ]
          }
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_telemetry\" and r._field == \"battery_soc\") |> last()"
      }]
    },
    {
      "id": 2,
      "title": "Motor Current (A)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 9, "x": 6, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "orange", "value": 1.5},
              {"color": "red", "value": 2.5}
            ]
          }
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"robot_telemetry\" and r._field == \"motor_current_a\")"
      }]
    },
    {
      "id": 3,
      "title": "Cleaning Coverage (%)",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 9, "x": 15, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "steps": [
              {"color": "blue", "value": 0},
              {"color": "green", "value": 90}
            ]
          }
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_state\" and r._field == \"cleaning_coverage_pct\") |> last()"
      }]
    },
    {
      "id": 4,
      "title": "Robot Position X (m)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 6},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"robot_telemetry\" and (r._field == \"x_m\" or r._field == \"y_m\"))"
      }]
    },
    {
      "id": 5,
      "title": "Obstacle Distance (cm)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 6},
      "fieldConfig": {
        "defaults": {
          "unit": "lengthcm",
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "orange", "value": 25},
              {"color": "green", "value": 50}
            ]
          }
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"robot_telemetry\" and r._field == \"obstacle_cm\")"
      }]
    },
    {
      "id": 6,
      "title": "Motor Temperature (C)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 12},
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "orange", "value": 55},
              {"color": "red", "value": 70}
            ]
          }
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"robot_telemetry\" and r._field == \"motor_temperature_c\")"
      }]
    },
    {
      "id": 7,
      "title": "Safety State",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 12},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {
              "1": {"text": "SAFE",      "color": "green",  "index": 0},
              "2": {"text": "WARNING",   "color": "orange", "index": 1},
              "3": {"text": "EMERGENCY", "color": "red",    "index": 2}
            }}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_state\" and r._field == \"safety_state\") |> last() |> map(fn: (r) => ({r with _value: if r._value == \"SAFE\" then 1 else if r._value == \"WARNING\" then 2 else if r._value == \"EMERGENCY\" then 3 else 0}))"
      }]
    },
    {
      "id": 8,
      "title": "Mission State",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 12},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {
              "0": {"text": "NOT STARTED", "color": "gray",   "index": 0},
              "1": {"text": "RUNNING",     "color": "green",  "index": 1},
              "2": {"text": "PAUSED",      "color": "orange", "index": 2},
              "3": {"text": "COMPLETED",   "color": "blue",   "index": 3},
              "4": {"text": "ABORTED",     "color": "red",    "index": 4}
            }}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_state\" and r._field == \"mission_state\") |> last() |> map(fn: (r) => ({r with _value: if r._value == \"NOT_STARTED\" then 0 else if r._value == \"RUNNING\" then 1 else if r._value == \"PAUSED\" then 2 else if r._value == \"COMPLETED\" then 3 else if r._value == \"ABORTED\" then 4 else -1}))"
      }]
    },
    {
      "id": 9,
      "title": "AI Motor Health Prediction",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 18},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {
              "1": {"text": "NORMAL",     "color": "green",    "index": 0},
              "2": {"text": "HIGH LOAD",  "color": "orange",   "index": 1},
              "3": {"text": "OVERHEATED", "color": "red",      "index": 2},
              "4": {"text": "FAULT",      "color": "dark-red", "index": 3}
            }}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_prediction\" and r._field == \"motor_health\") |> last() |> map(fn: (r) => ({r with _value: if r._value == \"NORMAL\" then 1 else if r._value == \"HIGH_LOAD\" then 2 else if r._value == \"OVERHEATED\" then 3 else if r._value == \"FAULT\" then 4 else 0}))"
      }]
    },
    {
      "id": 10,
      "title": "AI Dirt Level Prediction",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 18},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {
              "1": {"text": "CLEAN",    "color": "green",  "index": 0},
              "2": {"text": "MODERATE", "color": "orange", "index": 1},
              "3": {"text": "DIRTY",    "color": "red",    "index": 2}
            }}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_prediction\" and r._field == \"dirt_level\") |> last() |> map(fn: (r) => ({r with _value: if r._value == \"CLEAN\" then 1 else if r._value == \"MODERATE\" then 2 else if r._value == \"DIRTY\" then 3 else 0}))"
      }]
    },
    {
      "id": 11,
      "title": "Active Alarm Count",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 18},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "red", "value": 1}
            ]
          }
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_state\" and r._field == \"alarm_count\") |> last()"
      }]
    },
    {
      "id": 12,
      "title": "Battery Voltage (V)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 22},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"robot_telemetry\" and r._field == \"battery_v\")"
      }]
    },
    {
      "id": 13,
      "title": "Dirt Score",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 22},
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "orange", "value": 0.3},
              {"color": "red", "value": 0.7}
            ]
          }
        }
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"robot_telemetry\" and r._field == \"dirt_score\")"
      }]
    },
    {
      "id": 14,
      "title": "Alarm History",
      "type": "table",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 28},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "InfluxDB"},
        "query": "from(bucket: \"smartclean_twin\") |> range(start: -1h) |> filter(fn: (r) => r._measurement == \"robot_alarm\") |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> sort(columns: [\"_time\"], desc: true) |> limit(n: 50)"
      }]
    }
  ],
  "schemaVersion": 36,
  "tags": ["smartclean", "digital-twin", "robot"]
}
