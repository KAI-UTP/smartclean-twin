    {
      "id": 26,
      "title": "AI Recommendation",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Waiting for data...",
                  "color": "text"
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^Normal.*",
                "result": {
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^(STOP|Sensor).*",
                "result": {
                  "color": "red",
                  "index": 1
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^(Battery|Schedule|Motor).*",
                "result": {
                  "color": "orange",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB"
          },
          "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_prediction\" and r._field == \"recommendation\") |> last()"
