{
  "title": "SmartClean Twin - Robot Dashboard",
  "uid": "smartclean-main",
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 101,
      "type": "row",
      "title": "Robot Status Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 7,
      "title": "Safety State",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "SAFE",
                  "color": "green",
                  "index": 0
                },
                "2": {
                  "text": "WARNING",
                  "color": "orange",
                  "index": 1
                },
                "3": {
                  "text": "EMERGENCY",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB"
          },
          "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_state\" and r._field == \"safety_state\") |> last() |> map(fn: (r) => ({r with _value: if r._value == \"SAFE\" then 1 else if r._value == \"WARNING\" then 2 else if r._value == \"EMERGENCY\" then 3 else 0}))"
        }
      ]
    },
    {
      "id": 8,
      "title": "Mission State",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT STARTED",
                  "color": "gray",
                  "index": 0
                },
                "1": {
                  "text": "RUNNING",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "PAUSED",
                  "color": "orange",
                  "index": 2
                },
                "3": {
                  "text": "COMPLETED",
                  "color": "blue",
                  "index": 3
                },
                "4": {
                  "text": "ABORTED",
                  "color": "red",
                  "index": 4
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB"
          },
          "query": "from(bucket: \"smartclean_twin\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"robot_state\" and r._field == \"mission_state\") |> last() |> map(fn: (r) => ({r with _value: if r._value == \"NOT_STARTED\" then 0 else if r._value == \"RUNNING\" then 1 else if r._value == \"PAUSED\" then 2 else if r._value == \"COMPLETED\" then 3 else if r._value == \"ABORTED\" then 4 else -1}))"
        }
      ]
    },
