{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SmartClean Command Acknowledgement",
  "type": "object",
  "required": ["robot_id", "command_id", "command", "accepted", "timestamp"],
  "properties": {
    "robot_id": {"type": "string"},
    "command_id": {"type": "string"},
    "command": {"type": "string"},
    "accepted": {"type": "boolean"},
    "timestamp": {"type": "string", "format": "date-time"},
    "reason": {"type": "string"}
  }
}
