# SmartClean Twin — environment variable template
# Copy this file to .env and fill in values before running docker compose up

# ── MQTT ──────────────────────────────────────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883

# ── InfluxDB ──────────────────────────────────────────────────────────────────
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=smartclean-super-secret-token
INFLUXDB_ORG=smartclean
INFLUXDB_BUCKET=smartclean_twin
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=adminpassword
DOCKER_INFLUXDB_INIT_ORG=smartclean
DOCKER_INFLUXDB_INIT_BUCKET=smartclean_twin
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=smartclean-super-secret-token

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ── Robot Simulator ───────────────────────────────────────────────────────────
ROBOT_ID=SCR01
TELEMETRY_INTERVAL_S=1.0
SIMULATOR_SEED=42
SIMULATOR_PORT=8004

# ── Services ──────────────────────────────────────────────────────────────────
TELEMETRY_INGESTION_PORT=8001
STATE_ENGINE_PORT=8002
AI_SERVICE_PORT=8003
COMMAND_API_PORT=8000
